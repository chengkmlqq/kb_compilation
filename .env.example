# ============================================================================
# KB Compilation Platform — environment template
# Copy to .env and fill in values. Variable names follow the source platform
# conventions so the service can be dropped into the existing deployment.
# ============================================================================

# --- Database ---
# Dialect: pg | postgres | postgresql | kingbasees8 | mysql
DB_TYPE=mysql
# SQLAlchemy URL. For MySQL use mysql+pymysql://user:pass@host:port/dbname
DATABASE_URL=mysql+pymysql://modo:change-me@127.0.0.1:13308/data_synth_neo
SCHEMA_NAME=public
DB_MAX_CONNECTIONS=10
DB_POOL_PRE_PING=1

# --- Auth (aligned with the source platform) ---
AUTH_SECRET=***
SSO_ENABLED=0
SSO_URL=
COOKIES_MAX_AGE=172800
# JWT 换签认证（挂载场景 URL 带 ?jwt= 免二次登录）：
# 宿主系统用 HS256 共享密钥签发 JWT（payload 含 userId/sub + exp），
# 前端调 /api/v1/auth/jwt-exchange 换签 x-next-identity cookie 后走正常认证。
# 留空 = 端点禁用。JWT_ISSUER 可选（配置后校验 iss 白名单）。
JWT_SECRET=
JWT_ISSUER=
# URL 携带 JWT 最大可接受时效（秒），默认 900（15 分钟），防 token 流入日志
JWT_MAX_AGE=900

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND override REDIS_URL when set
CELERY_TIMEZONE=Asia/Shanghai
JOB_BEAT_SCAN_INTERVAL_SECONDS=30

# --- Agent gateway (hermes-agent skill execution) ---
# Base URL of the agent-gateway service. In docker-compose the celery worker
# reaches the host-bound gateway via host.docker.internal:8080.
AGENT_GATEWAY_BASE_URL=http://127.0.0.1:8080
# Global wait budget for one gateway task (full skill runs take 10-25 min).
AGENT_GATEWAY_TIMEOUT_S=3600
AGENT_GATEWAY_POLL_INTERVAL_S=15

# --- Server ---
APP_PORT=8000
LOG_LEVEL=info
