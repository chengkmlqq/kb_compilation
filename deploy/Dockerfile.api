# syntax=docker/dockerfile:1.7
# KB api-server: FastAPI + Celery worker/beat in one image.
#   api-server:  uvicorn api.main:app
#   celery-worker: celery -A worker.celery_app worker
#   celery-beat:  celery -A worker.celery_app beat

ARG PY_BASE_IMAGE=python:3.11-slim

FROM ${PY_BASE_IMAGE} AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv/kb

# system deps used by docreader's PDF/HTML engines and playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        fonts-liberation \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
    && rm -rf /var/lib/apt/lists/*

# uv: faster + deterministic (matches the repo's uv.lock)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
# install deps as a runtime package (no build isolation on our own project)
RUN uv sync --frozen --no-dev --no-install-project

COPY api/ ./api/
COPY worker/ ./worker/
COPY docreader/ ./docreader/
COPY scripts/ ./scripts/
RUN mkdir -p /data/kb_documents

ENV PATH="/srv/kb/.venv/bin:$PATH"

EXPOSE 8000

# default command: api server
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]