# syntax=docker/dockerfile:1.7
# KB worker: Celery worker / beat / flower in one image.
#   Worker:   celery -A worker.celery_app worker   --loglevel=info
#   Beat:     celery -A worker.celery_app beat     --loglevel=info
#   Flower:   celery -A worker.celery_app flower   --address=0.0.0.0 --port=5555
#
# Worker 任务重度依赖 api/（import api.config / api.db / api.models.* / api.services.*），
# 因此 api/ 目录必须一同打入本镜像。

ARG PY_BASE_IMAGE=python:3.11-slim

FROM ${PY_BASE_IMAGE} AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv/kb

# system deps used by docreader's PDF/HTML engines and playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        fonts-liberation \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
    && rm -rf /var/lib/apt/lists/*

# uv: faster + deterministic (matches the repo's uv.lock)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY api/ ./api/
COPY worker/ ./worker/
COPY docreader/ ./docreader/
COPY scripts/ ./scripts/
COPY alembic.ini ./
COPY migrations/ ./migrations/
RUN mkdir -p /data/kb_documents

ENV PATH="/srv/kb/.venv/bin:$PATH" \
    PYTHONPATH="/srv/kb"

EXPOSE 5555
# flower web UI（可选，通过 nginx 代理访问 /flower/）

# default: celery worker
CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
